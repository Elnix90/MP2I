{
  "logging": {
    "console": {
      "enable": true,
      level: "DEBUG",
      "format": "%(asctime)s - %(filename)s:%(lineno)d - %(message)s"
    },
    "file": {
      "enable": true,
      "file": "logs/mp2i.log",
      "level": "DEBUG",
      "format": "%(asctime)s - %(filename)s:%(lineno)d - %(levelname)s - %(message)s"
    },
    "discord": {
      "enable": true,
      "webhook": "https://discord.com/api/webhooks/<URL>",
      "format": "%(asctime)s - %(filename)s:%(lineno)d\n%(message)s"
    }
  }
}
